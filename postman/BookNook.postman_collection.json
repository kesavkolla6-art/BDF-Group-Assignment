{
  "info": {
    "name": "BookNook Cafe API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the whole collection in order with the Collection Runner. The setup request creates a fresh guest, so it can be run again and again."
  },
  "item": [
    {
      "name": "Guests",
      "item": [
        {
          "name": "Setup: add a fresh guest for the twist tests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/guests/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha {{tag}}\",\n  \"phone\": \"9000000099\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"tag\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"guestId\", pm.response.json().guestId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Guests: get all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "guests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
